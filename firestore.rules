rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bankState/{document} {
      allow read, write: if request.auth != null;
    }

    match /bankTransactions/{document} {
      allow read, write: if request.auth != null;
    }

    match /bankNotifications/{document} {
      allow read, write: if request.auth != null;
    }

    match /bankFraudReports/{document} {
      allow read, write: if request.auth != null;
    }

    match /bankShopOrders/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
